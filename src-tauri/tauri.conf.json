{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBeacon",
  "version": "0.2.0-beta.2",
  "identifier": "org.openbeacon.maptest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenBeacon",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://api.weather.gov https://api.protomaps.com; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": false,
    "resources": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QTcwNDQwQzZCRDRFMkEKUldRcVRyM0dRQVNudG5wWUVXYVdxVloxN3hyVVFQMHJsRGJzZWxBdk9iMUFRcVpVNXdUS1pIdnkK",
      "endpoints": [
        "https://raw.githubusercontent.com/sideout909/OpenBeacon/update-feed/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
